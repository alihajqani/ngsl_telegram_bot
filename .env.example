# ═══════════════════════════════════════════════════════════════════════════
# NGSL Bot v2 — environment
# Every variable below is parsed and validated by Zod at startup
# (packages/shared/src/config.ts). The process refuses to boot if anything
# is missing or malformed, and reports ALL problems at once.
# ═══════════════════════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info                       # fatal | error | warn | info | debug | trace
APP_TIMEZONE=Asia/Tehran             # day boundaries for streaks and daily caps

# ── Telegram ───────────────────────────────────────────────────────────────
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
REQUIRED_CHANNEL=@your_channel       # force-join gate; omit to disable
ADMIN_TELEGRAM_IDS=11111111          # comma-separated numeric IDs

# ── PostgreSQL ─────────────────────────────────────────────────────────────
# DATABASE_URL is what the APPS connect with.
# POSTGRES_* are what docker-compose.yml creates the container with.
# They must agree: the URL's user/password/database are these three values.
POSTGRES_USER=ngsl
POSTGRES_PASSWORD=change-me            # required — compose refuses to start without it
POSTGRES_DB=ngsl
DATABASE_URL=postgres://ngsl:change-me@localhost:5432/ngsl
DATABASE_POOL_MAX=10

# ── Redis (sessions + BullMQ) ──────────────────────────────────────────────
# REDIS_PASSWORD arms `--requirepass`, so REDIS_URL must carry it too.
# Note the empty username: redis://:PASSWORD@host:port
REDIS_PASSWORD=change-me               # required — compose refuses to start without it
REDIS_URL=redis://:change-me@localhost:6379

# Generate real values with:  openssl rand -base64 24

# ── LLM ────────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini                  # gemini | vllm
GEMINI_API_KEYS=key1,key2,key3       # required when provider=gemini; rotated round-robin
GEMINI_MODEL=gemini-2.0-flash
# Outbound HTTPS proxy — applies to Gemini and to the Telegram monitor.
# HTTPS_PROXY=http://10.16.0.170:2080

# vLLM — used when LLM_PROVIDER=vllm, and as the fallback when every Gemini key
# is rate-limited. VLLM_MODEL is required whenever VLLM_BASE_URL is set.
# VLLM_BASE_URL=http://localhost:8000
# VLLM_MODEL=qwen2.5-14b
# VLLM_API_KEY=
LLM_TIMEOUT_MS=60000

# ── Media tooling ──────────────────────────────────────────────────────────
YTDLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
YTDLP_JS_RUNTIME=node                # solves YouTube's player challenges; yt-dlp enables only Deno by default
CLIP_TMP_DIR=/tmp/ngsl-clips
CLIP_PAD_BEFORE_MS=250               # silence kept before the first spoken word
CLIP_PAD_AFTER_MS=400                # and after the last one
CLIP_MAX_SEC=20                      # longer sentences are skipped, never cut short
CLIP_MAX_HEIGHT=480

# Forced alignment. docker-compose sets ALIGNER_URL for the worker itself; set
# it here only when running the worker outside compose. Unset → cuts fall back
# to subtitle timing snapped to the nearest pause.
# ALIGNER_URL=http://localhost:8000
ALIGN_MIN_SCORE=0.35                 # below this the subtitle text does not match the audio

# SECURITY: cookies are mounted at RUNTIME, never committed and never COPYed
# into an image. v1 leaked a live Google session this way. Use a throwaway
# Google account. The host file is bind-mounted read-only into the worker, which
# hands yt-dlp a private writable copy (yt-dlp writes the jar back on exit).
# YOUTUBE_COOKIES_HOST_PATH=/home/you/.secrets/youtube_cookies.txt
# YOUTUBE_COOKIES_FILE=/run/secrets/youtube_cookies.txt

# The strongest levers against HTTP 403 / "confirm you're not a bot" on a
# flagged server IP. Retune without a redeploy.
# YTDLP_EXTRACTOR_ARGS=youtube:player_client=default,web_safari
# YTDLP_PROXY=http://user:pass@host:port

# ── Clip vault ─────────────────────────────────────────────────────────────
# A private forum topic whose only job is to mint reusable Telegram file_ids.
# Render once here, then every future send is free and instant.
CLIP_VAULT_GROUP_ID=-1001234567890
CLIP_VAULT_THREAD_ID=5

# ── Observability (Telegram forum topics as an ops dashboard) ──────────────
# Create a group with Topics enabled, add the bot as admin, post once in each
# topic, then read message.message_thread_id from getUpdates.
# Leave MONITOR_GROUP_ID unset to run without the dashboard — a placeholder id
# makes Telegram reject every message and the monitor switches itself off.
MONITOR_GROUP_ID=-1001234567890
MONITOR_THREAD_TECHNICAL=1
MONITOR_THREAD_USERS=2
MONITOR_THREAD_FEATURES=3
MONITOR_THREAD_SUMMARY=4

# ── Ingest & render pacing (the bot-detection blast radius) ────────────────
INGEST_SUBTITLE_CONCURRENCY=2
INGEST_REQUEST_DELAY_MS=3000
ENUMERATE_TTL_DAYS=30                # re-read a channel feed after this; until then ingest uses the cache
CLIP_RENDER_CONCURRENCY=1
PREWARM_BREADTH_TARGET=10            # every word reaches clips from this many different videos
PREWARM_DEPTH_TARGET=30              # then words grow toward this many videos
RENDER_VIDEOS_PER_HOUR=12            # source downloads per hour: the whole exposure to YouTube
RENDER_MAX_CLIPS_PER_VIDEO=60        # clips cut from one download
BOT_WALL_PAUSE_MIN=90                # every render stops this long after YouTube's bot wall

# ── Feature flags ──────────────────────────────────────────────────────────
ENABLE_PREWARM=true
ENABLE_REMINDERS=true
